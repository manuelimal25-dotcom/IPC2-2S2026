@page
@{
    ViewData["Title"] = "Libros por categoría";
}

<h1>Libros de una categoría</h1>
<p>Selecciona una categoría para consultar sus libros.</p>

<form class="form-libro panel-narrow" id="formCategoria">
    <label for="categoria">Categoría</label>
    <select id="categoria" name="categoria">
        <option>Novela</option>
        <option>Ciencia</option>
        <option>Historia</option>
    </select>
    <button class="boton-principal" type="submit">Mostrar libros</button>
</form>

<div class="panel" id="listaCategoria" hidden>
    <h2>Libros encontrados</h2>
    <ul class="lista-resultados">
        <li>El principito <span>ISBN 101</span></li>
        <li>Viaje al centro de la Tierra <span>ISBN 205</span></li>
    </ul>
</div>

@section Scripts {
    <script>
        document.getElementById("formCategoria").addEventListener("submit", function (evento) {
            evento.preventDefault();
            document.getElementById("listaCategoria").hidden = false;
        });
    </script>
}