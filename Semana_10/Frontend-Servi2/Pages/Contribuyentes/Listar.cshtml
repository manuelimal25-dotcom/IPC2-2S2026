@page
@model Frontend_Servi2.Pages.Contribuyentes.ListarModel
@{
    ViewData["Title"] = "Listar contribuyentes";
}

@if (!Model.Respuesta.Exito)
{
    <partial name="_Alerta" model="Model.Respuesta" />
}

<table>
    <thead>
        <tr><th>NIT</th><th>Nombre</th><th>Acciones</th></tr>
    </thead>
    <tbody>
    @if (Model.Contribuyentes.Count == 0)
    {
        <tr><td colspan="3">No hay contribuyentes registrados.</td></tr>
    }
    @foreach (var contribuyente in Model.Contribuyentes)
    {
        <tr>
            <td>@contribuyente.Nit</td>
            <td>@contribuyente.Nombre</td>
            <td class="acciones">
                <a asp-page="/Contribuyentes/Reemplazar" asp-route-nit="@contribuyente.Nit">Editar</a>
                <a asp-page="/Contribuyentes/ActualizarNombre" asp-route-nit="@contribuyente.Nit">Cambiar nombre</a>
                <a asp-page="/Contribuyentes/Eliminar" asp-route-nit="@contribuyente.Nit">Eliminar</a>
            </td>
        </tr>
    }
    </tbody>
</table>

