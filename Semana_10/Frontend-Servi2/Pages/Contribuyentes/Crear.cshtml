@page
@model Frontend_Servi2.Pages.Contribuyentes.CrearModel
@{
    ViewData["Title"] = "Crear contribuyente";
}

<p class="ruta-api">POST /api/contribuyentes</p>
<form method="post" class="formulario">
    <div class="campo"><label asp-for="Nit">NIT</label><input asp-for="Nit" /></div>
    <div class="campo"><label asp-for="Nombre">Nombre</label><input asp-for="Nombre" /></div>
    <button class="boton" type="submit">Crear contribuyente</button>
</form>
<partial name="_Respuesta" model="Model.Respuesta" />
